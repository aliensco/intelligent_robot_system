<?xml version="1.0"?>
<package format="2">
  <name>rgbd_following</name>
  <version>0.1.0</version>
  <description>Method 3 live RGB-D target tracking, rolling odom navigation and motion guards.</description>
  <maintainer email="50793097+yky666@users.noreply.github.com">yky666</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>roscpp</depend>
  <depend>costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>actionlib</depend>
  <depend>move_base_msgs</depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>python-opencv</exec_depend>
  <exec_depend>python-numpy</exec_depend>
  <exec_depend>rosbag</exec_depend>
  <test_depend>rostest</test_depend>
  <test_depend>dynamic_reconfigure</test_depend>
  <test_depend>tf</test_depend>
  <export><costmap_2d plugin="${prefix}/clearance_plugins.xml" /></export>
</package>
