<launch>
  <arg name="robot_ns" default="tb3" />
  <arg name="execute" default="false" />
  <arg name="commissioning_clearance" default="false" />
  <arg name="allow_unobserved" default="false" />
  <arg name="settings" default="$(find rgbd_following)/config/follow.yaml" />
  <!-- Defaults suit ONE robot with the course's existing unprefixed drivers. -->
  <arg name="odom_frame" default="odom" />
  <arg name="base_frame" default="base_footprint" />
  <arg name="odom_topic" default="/odom" />
  <arg name="rgb_topic" default="/camera/rgb/image_rect_color" />
  <arg name="depth_topic" default="/camera/depth_registered/image_rect" />
  <arg name="info_topic" default="/camera/rgb/camera_info" />
  <arg name="mission_topic" default="/competition/mission" />
  <arg name="estop_topic" default="/competition/estop" />
  <arg name="cmd_vel_topic" default="/cmd_vel_mux/input/navi" />
  <group ns="$(arg robot_ns)">
    <node pkg="rgbd_following" type="rgbd_target.py" name="rgbd_target" output="screen" required="true">
      <rosparam command="load" file="$(arg settings)" ns="settings" />
      <param name="odom_frame" value="$(arg odom_frame)" />
      <remap from="rgb" to="$(arg rgb_topic)" />
      <remap from="registered_depth" to="$(arg depth_topic)" />
      <remap from="camera_info" to="$(arg info_topic)" />
    </node>
    <node pkg="move_base" type="move_base" name="move_base" output="screen" required="true">
      <rosparam command="load" file="$(find rgbd_following)/config/navigation.yaml" />
      <rosparam command="load" file="$(find rgbd_following)/config/costmap.yaml" ns="global_costmap" />
      <rosparam command="load" file="$(find rgbd_following)/config/costmap.yaml" ns="local_costmap" />
      <!-- Explicit supervised field policy; default remains unknown=blocked.
           This is a planning assumption, not evidence that the space is clear.
           Live obstacle marking, voxel height protection and gate stay active. -->
      <param if="$(arg allow_unobserved)" name="global_costmap/track_unknown_space" value="false" />
      <param if="$(arg allow_unobserved)" name="local_costmap/track_unknown_space" value="false" />
      <param if="$(arg allow_unobserved)" name="global_costmap/obstacles/track_unknown_space" value="false" />
      <param if="$(arg allow_unobserved)" name="local_costmap/obstacles/track_unknown_space" value="false" />
      <!-- Explicit, temporary commissioning evidence only. Never enabled by default. -->
      <rosparam if="$(arg commissioning_clearance)" param="global_costmap/plugins">
        - {name: obstacles, type: 'costmap_2d::VoxelLayer'}
        - {name: commissioning_clearance, type: 'rgbd_following/CommissioningClearanceLayer'}
        - {name: inflation, type: 'costmap_2d::InflationLayer'}
      </rosparam>
      <rosparam if="$(arg commissioning_clearance)" param="local_costmap/plugins">
        - {name: obstacles, type: 'costmap_2d::VoxelLayer'}
        - {name: commissioning_clearance, type: 'rgbd_following/CommissioningClearanceLayer'}
        - {name: inflation, type: 'costmap_2d::InflationLayer'}
      </rosparam>
      <param if="$(arg commissioning_clearance)" name="global_costmap/commissioning_clearance/polygon_topic" value="/$(arg robot_ns)/commissioning_clearance" />
      <param if="$(arg commissioning_clearance)" name="local_costmap/commissioning_clearance/polygon_topic" value="/$(arg robot_ns)/commissioning_clearance" />
      <param name="global_costmap/global_frame" value="$(arg odom_frame)" />
      <param name="global_costmap/robot_base_frame" value="$(arg base_frame)" />
      <param name="local_costmap/global_frame" value="$(arg odom_frame)" />
      <param name="local_costmap/robot_base_frame" value="$(arg base_frame)" />
      <remap from="odom" to="$(arg odom_topic)" />
      <remap from="cmd_vel" to="cmd_vel_raw" />
    </node>
    <node pkg="rgbd_following" type="rgbd_follower.py" name="rgbd_follower" output="screen" required="true">
      <rosparam command="load" file="$(arg settings)" ns="settings" />
      <param name="execute" value="$(arg execute)" />
      <param name="odom_frame" value="$(arg odom_frame)" />
      <param name="base_frame" value="$(arg base_frame)" />
      <remap from="mission" to="$(arg mission_topic)" />
      <remap from="odom" to="$(arg odom_topic)" />
      <remap from="estop" to="$(arg estop_topic)" />
    </node>
    <node pkg="rgbd_following" type="rgbd_velocity_gate.py" name="rgbd_velocity_gate" output="screen" required="true">
      <rosparam command="load" file="$(arg settings)" ns="settings" />
      <param name="execute" value="$(arg execute)" />
      <param name="odom_frame" value="$(arg odom_frame)" />
      <param name="base_frame" value="$(arg base_frame)" />
      <remap from="cmd_vel_safe" to="$(arg cmd_vel_topic)" />
      <remap from="odom" to="$(arg odom_topic)" />
      <remap from="camera_info" to="$(arg info_topic)" />
      <remap from="estop" to="$(arg estop_topic)" />
    </node>
  </group>
</launch>
